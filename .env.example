# Copy to .env (which is gitignored) and fill in what you need.
#
# Node's native .env loading does NOT override variables already set in your
# shell -- the shell wins. A stale key exported in your session silently
# shadows this file, which is a confusing way to fail. `unset` it if in doubt.

# A key is needed ONLY for live discovery, and for `ask`. Replay never calls a
# model at all. `npm run demo` needs nothing.

# The committed evidence was produced with this one. Free, no card.
# https://console.groq.com/keys
GROQ_API_KEY=

# Being retired by GitHub -- the endpoint currently answers 410. Kept because
# it costs nothing: it is the same OpenAI-compatible client as the rest.
GITHUB_MODELS_TOKEN=

# Free, but roughly 20 requests a day -- enough for one capability, not the
# whole demo. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Roughly 10 cents per discovery run. Also the only provider `ask` supports.
ANTHROPIC_API_KEY=

# The fixture's operator password. Not a secret -- the fixture accepts this one
# string -- but it is passed by environment rather than on the command line so
# it stays out of shell history, `ps`, and the console transcripts saved as
# evidence. Four commands in the README expect it.
CORETELLER_PASSWORD=demo-only-not-a-secret

# Optional model overrides. Both defaults are aliases that track a current
# model, deliberately: a pinned version retires and the failure looks like a bug.
PANTOGRAPH_MODEL=claude-sonnet-5
PANTOGRAPH_GEMINI_MODEL=gemini-flash-latest

# Optional: run discovery with the scripted planner instead of a live model.
# Equivalent to passing --mock-llm on the CLI.
PANTOGRAPH_MOCK_LLM=0

# Optional, for any OpenAI-compatible provider (--planner groq|github|openrouter|
# together|mistral|ollama). Each preset supplies its own defaults.
PANTOGRAPH_OPENAI_MODEL=
PANTOGRAPH_OPENAI_BASE_URL=

# Optional pacing, in milliseconds between requests. Raise either one if a free
# tier throttles you mid-run.
PANTOGRAPH_OPENAI_MIN_INTERVAL_MS=
PANTOGRAPH_GEMINI_MIN_INTERVAL_MS=

# Used by `npm run demo:public` against the public storefront. Its login page
# prints the value; there is nothing secret about it.
SAUCE_PASSWORD=secret_sauce

# Optional: move the fixture off its default port.
LEGACY_BANK_PORT=8731
