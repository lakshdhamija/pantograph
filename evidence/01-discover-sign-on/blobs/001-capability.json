  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "title": "No member exists for the supplied member number",
      "description": "The inquiry completed and the core returned no matching record. This is a legitimate answer, not an error: the caller should tell the user the number is unknown rather than retry.",
      "detect": {
        "kind": "text_present",
        "text": {
          "op": "contains",
          "value": "NO MATCHING RECORDS FOUND"
