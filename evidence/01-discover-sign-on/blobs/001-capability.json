    {
      "id": "wait-out-blank-screen",
      "title": "The screen rendered nothing; give a slow core time to answer",
      "detect": {
        "kind": "not",
        "of": {
          "kind": "text_present",
          "text": {
            "op": "regex",
            "value": ".",
            "flags": "i"
