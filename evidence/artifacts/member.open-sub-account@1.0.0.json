    },
    {
      "code": "REQUEST_REJECTED",
      "title": "The core rejected the request on validation grounds",
      "description": "Server-side validation refused the request. `validationMessages` carries the core's own wording, which the caller should surface rather than paraphrase.",
      "detect": {
        "kind": "text_present",
